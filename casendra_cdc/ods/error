## 2. `CassandraSourceConfig.java`

```java
package com.example.cdc.config;

import org.apache.kafka.common.config.AbstractConfig;
import org.apache.kafka.common.config.ConfigDef;

import java.util.List;
import java.util.Map;

public class CassandraSourceConfig extends AbstractConfig {
    public static final String HOSTS = "cassandra.contact.points";
    public static final String PORT  = "cassandra.port";
    public static final String KEYSPACE = "cassandra.keyspace.whitelist";
    public static final String TABLES   = "tables.whitelist";
    public static final String CDC_DIR  = "cdc.dir";

    public static final ConfigDef CONFIG_DEF = new ConfigDef()
        .define(HOSTS, ConfigDef.Type.LIST, ConfigDef.Importance.HIGH,
                "Cassandra contact points (host1,host2)")
        .define(PORT, ConfigDef.Type.INT, 9042, ConfigDef.Importance.HIGH,
                "Cassandra CQL port")
        .define(KEYSPACE, ConfigDef.Type.LIST, ConfigDef.Importance.HIGH,
                "Keyspaces to capture")
        .define(TABLES, ConfigDef.Type.LIST, ConfigDef.Importance.HIGH,
                "Tables to capture")
        .define(CDC_DIR, ConfigDef.Type.STRING, ConfigDef.Importance.HIGH,
                "Path to Cassandra cdc_raw_directory");

    public CassandraSourceConfig(Map<String, String> props) {
        super(CONFIG_DEF, props);
    }

    public List<String> getContactPoints() {
        return getList(HOSTS);
    }
    public int getPort() {
        return getInt(PORT);
    }
    public List<String> getKeyspaces() {
        return getList(KEYSPACE);
    }
    public List<String> getTables() {
        return getList(TABLES);
    }
    public String getCdcDir() {
        return getString(CDC_DIR);
    }
}
```

