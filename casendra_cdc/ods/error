## 4. `CassandraCommitLogTask.java`

```java
package com.example.cdc;

import com.example.cdc.config.CassandraSourceConfig;
import org.apache.cassandra.db.commitlog.CommitLog;
import org.apache.cassandra.db.commitlog.CommitLogDescriptor;
import org.apache.cassandra.db.commitlog.CommitLogReadHandler;
import org.apache.cassandra.db.commitlog.CommitLogReader;
import org.apache.cassandra.utils.Pair;
import org.apache.kafka.connect.source.SourceRecord;
import org.apache.kafka.connect.source.SourceTask;

import java.io.File;
import java.util.*;

public class CassandraCommitLogTask extends SourceTask {
    private CassandraSourceConfig config;
    private File cdcDir;
    private long offset = 0;

    @Override
    public String version() {
        return "1.0.0";
    }

    @Override
    public void start(Map<String, String> props) {
        config = new CassandraSourceConfig(props);
        cdcDir = new File(config.getCdcDir());
        // load offset from context
        Map<String, ?> lastOffsets = context.offsetStorageReader()
            .offset(Collections.singletonMap("cdc_dir", config.getCdcDir()));
        if (lastOffsets != null && lastOffsets.containsKey("position")) {
            offset = (Long) lastOffsets.get("position");
        }
    }

    @Override
    public List<SourceRecord> poll() throws InterruptedException {
        List<SourceRecord> records = new ArrayList<>();

        // List .cdc files sorted by creation time
        File[] files = cdcDir.listFiles((d, n) -> n.endsWith(".cdc"));
        if (files != null) {
            Arrays.sort(files, Comparator.comparingLong(File::lastModified));
            for (File f : files) {
                long fileId = CommitLogDescriptor.fromFileName(f.getName()).id;
                if (fileId <= offset) continue;

                // Read only this segment
                CommitLogReader reader = new CommitLogReader(true, 1024);
                reader.readCommitLogSegments(Collections.singletonList(f),
                    new CommitLogReadHandler() {
                        public boolean onMutation(CommitLogDescriptor desc, CommitLogMutation mutation) {
                            // Convert to SourceRecord
                            Map<String, ?> partition = Map.of("cdc_dir", config.getCdcDir());
                            Map<String, ?> pos       = Map.of("position", desc.id);
                            String topic = "cdc_" + mutation.getKeyspace() + "." + mutation.getCFName();
                            Map<String, Object> key = Map.of("pk", mutation.partitionKey());
                            Map<String, Object> value = Map.of("mutation", mutation); // serialize as needed
                            SourceRecord sr = new SourceRecord(
                                partition, pos, topic, null,
                                null, null,
                                key, null,
                                value, null
                            );
                            records.add(sr);
                            return true;
                        }
                    }
                );
                offset = fileId;
            }
        }

        // Sleep briefly before next scan
        Thread.sleep(1000);
        return records;
    }

    @Override
    public void stop() {
        // nothing
    }
}
```

