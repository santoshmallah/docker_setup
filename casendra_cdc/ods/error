## 3. `CassandraCommitLogConnector.java`

```java
package com.example.cdc;

import com.example.cdc.config.CassandraSourceConfig;
import org.apache.kafka.connect.connector.Task;
import org.apache.kafka.connect.source.SourceConnector;

import java.util.ArrayList;
import java.util.List;
import java.util.Map;

public class CassandraCommitLogConnector extends SourceConnector {
    private Map<String, String> configProps;

    @Override
    public String version() {
        return "1.0.0";
    }

    @Override
    public void start(Map<String, String> props) {
        configProps = props;
    }

    @Override
    public Class<? extends Task> taskClass() {
        return CassandraCommitLogTask.class;
    }

    @Override
    public List<Map<String, String>> taskConfigs(int maxTasks) {
        // For simplicity, each task gets full config
        List<Map<String, String>> configs = new ArrayList<>();
        for (int i = 0; i < maxTasks; i++) {
            configs.add(configProps);
        }
        return configs;
    }

    @Override
    public void stop() {
        // Nothing to do on shutdown
    }

    @Override
    public ConfigDef config() {
        return CassandraSourceConfig.CONFIG_DEF;
    }
}
```

